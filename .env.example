# Copy to `.env` and fill in real values. Never commit the real file.

PROJECT_NAME=StudyHub API
APP_VERSION=0.1.0
ENVIRONMENT=development

# SQLite during development (relative paths are resolved inside backend/).
# For deployment use a PostgreSQL URL, e.g.
# postgresql+psycopg://user:password@host:5432/studyhub
DATABASE_URL=sqlite:///./study.db

# Comma-separated list of allowed web origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (and checked) when ENVIRONMENT=development is changed to `production`.
JWT_SECRET=replace-me

# Access-token lifetime in minutes (default 10080 = 7 days).
JWT_EXPIRE_MINUTES=10080

# Object storage for note attachments: "local" (files under backend/uploads/)
# or "s3" (Cloudflare R2 / Backblaze B2 — both speak the S3 API).
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Required for R2, e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_REGION=auto
# Optional: serve files from a public bucket/CDN instead of presigned URLs.
STORAGE_PUBLIC_URL=

# Local upload folder and per-file size cap in bytes (default 20 MiB).
UPLOAD_DIR=
MAX_UPLOAD_BYTES=20971520

# AI summaries: a key from https://openrouter.ai/keys makes every PDF upload
# get summarised automatically (no button involved). Without a key uploads
# still work and the attachment is marked `summary_status: "skipped"`.
OPENROUTER_API_KEY=
# Any OpenAI-compatible chat model on OpenRouter; free models change often.
SUMMARY_MODEL=meta-llama/llama-3.3-70b-instruct:free
SUMMARY_MAX_CHARS=16000
SUMMARY_MAX_TOKENS=400

# Seeded moderation account. ADMIN_PASSWORD below is a placeholder only - put a
# real value in your own `.env`. ENVIRONMENT=production refuses to start while
# it is still a placeholder or the development default.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_PHONE=0000000000
